module selfhost.compiler.bridge.bridge_client

import ori.fs as fs
import ori.list as lists
import ori.process as proc

public struct CompileArtifactResult
    is_ok: bool
    obj_path: string
    exe_path: string
    message: string
end

public invoke_bridge_and_link(
    bridge_payload_json: string,
    obj_path: string,
    exe_path: string,
    bridge_server_bin: string
) -> CompileArtifactResult
    -- 1. Write the payload JSON to a temporary request file
    const req_file = f"{obj_path}.req.json"
    match fs.write_text(req_file, bridge_payload_json)
    case err(e):
        return CompileArtifactResult {
            is_ok: false,
            obj_path: obj_path,
            exe_path: exe_path,
            message: f"failed to write bridge request: {e}"
        }
    case ok(_):
    end

    -- 2. Call ori-bridge-server subprocess
    const bridge_args: list[string] = []
    lists.push(bridge_args, "--request-file")
    lists.push(bridge_args, req_file)

    match proc.run_output(bridge_server_bin, bridge_args)
    case ok(pout):
        if pout.status != 0
            return CompileArtifactResult {
                is_ok: false,
                obj_path: obj_path,
                exe_path: exe_path,
                message: f"bridge server exited with status {pout.status}"
            }
        end
    case err(e):
        return CompileArtifactResult {
            is_ok: false,
            obj_path: obj_path,
            exe_path: exe_path,
            message: f"bridge invoke: {e}"
        }
    end

    -- 3. Invoke native system linker
    const linker_args: list[string] = []
    lists.push(linker_args, obj_path)
    lists.push(linker_args, "-o")
    lists.push(linker_args, exe_path)

    match proc.run_output("cc", linker_args)
    case ok(lout):
        if lout.status != 0
            return CompileArtifactResult {
                is_ok: false,
                obj_path: obj_path,
                exe_path: exe_path,
                message: f"linker failed with status {lout.status}"
            }
        end
    case err(e):
        return CompileArtifactResult {
            is_ok: false,
            obj_path: obj_path,
            exe_path: exe_path,
            message: f"linker invoke: {e}"
        }
    end

    return CompileArtifactResult {
        is_ok: true,
        obj_path: obj_path,
        exe_path: exe_path,
        message: "compilation and link successful"
    }
end
