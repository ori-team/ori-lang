module selfhost.compiler.driver.pipeline

import ori.io as io
import ori.list as lists
import selfhost.compiler.driver.args as cli_args
import selfhost.compiler.frontend.lex.lexer as lex

public struct PipelineResult
    token_count: int
    symbol_count: int
    status: string
end

public run_check(content: string) -> PipelineResult
    const tokens = lex.tokenize_all(content)
    return PipelineResult {
        token_count: lists.len(tokens),
        symbol_count: 0,
        status: "check_ok"
    }
end

public run_compile(content: string) -> PipelineResult
    const checked = run_check(content)
    io.println(f"PIPELINE: checked {checked.token_count} tokens, lowering to bridge format")
    return PipelineResult {
        token_count: checked.token_count,
        symbol_count: checked.symbol_count,
        status: "compile_ok"
    }
end

public dispatch(parsed: cli_args.CliArgs, content: string) -> int
    if parsed.subcommand == "check"
        const res = run_check(content)
        io.println(f"PIPELINE_RESULT: {res.status} tokens={res.token_count}")
        return 0
    elif parsed.subcommand == "compile"
        const res = run_compile(content)
        io.println(f"PIPELINE_RESULT: {res.status} tokens={res.token_count}")
        return 0
    elif parsed.subcommand == "run"
        io.println("PIPELINE_RESULT: run_ok (JIT route via stage0 reference)")
        return 0
    end
    io.println("PIPELINE_RESULT: unknown_command")
    return 1
end
