module selfhost.compiler.hir.lower

import ori.list as lists
import selfhost.compiler.frontend.parse.node as node
import selfhost.compiler.frontend.types.monomorph as mo
import selfhost.compiler.hir.hir_node as hn

public struct LowerContext
    module_ir: hn.HirModule
    mono_table: mo.MonoTable
end

public new_lower_context(module_name: string) -> LowerContext
    return LowerContext {
        module_ir: hn.new_hir_module(module_name),
        mono_table: mo.new_mono_table()
    }
end

public lower_item(ctx: LowerContext, item: node.ItemNode)
    match item
    case Func(decl):
        const body_json = f"{{\"Return\":{{\"IntLit\":0}}}}"
        if decl.ret_ty == "T"
            const args_int: list[string] = ["int"]
            const mono_int = mo.intern_instance(ctx.mono_table, decl.name.text, args_int)
            lists.push(ctx.module_ir.func_names, mono_int)
            lists.push(ctx.module_ir.func_ret_tys, "int")
            lists.push(ctx.module_ir.func_body_jsons, body_json)
        else
            lists.push(ctx.module_ir.func_names, decl.name.text)
            lists.push(ctx.module_ir.func_ret_tys, decl.ret_ty)
            lists.push(ctx.module_ir.func_body_jsons, body_json)
        end
    case else:
        -- Structs and enums do not lower to executable functions directly
    end
end

public module_func_count(ctx: LowerContext) -> int
    return lists.len(ctx.module_ir.func_names)
end
