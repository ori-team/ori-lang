module app.simd_vector_math

-- Measures SIMD 4-lane vector addition throughput (LANG-SIMD-1).

import ori.io = io

main()
    var v: simd[float32, 4] = [1.0f32, 2.0f32, 3.0f32, 4.0f32]
    const step: simd[float32, 4] = [0.1f32, 0.2f32, 0.3f32, 0.4f32]
    var i: int = 0
    while i < 5_000_000
        v = v + step
        i = i + 1
    end
    io.println(string(v[0] + v[1] + v[2] + v[3]))
end
