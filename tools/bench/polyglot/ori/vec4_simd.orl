module app.bench_vec4_simd

import ori.io = io

main()
    var v: simd[float32, 4] = [1.0f32, 2.0f32, 3.0f32, 4.0f32]
    const step: simd[float32, 4] = [0.5f32, 0.25f32, 0.125f32, 0.0625f32]
    var i: int = 0
    while i < 5_000_000
        v = v + step
        i = i + 1
    end
    io.print(f"{v[0] + v[1] + v[2] + v[3]}")
end
