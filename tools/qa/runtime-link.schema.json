{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ori native runtime link metadata",
  "type": "object",
  "required": [
    "target",
    "runtime",
    "runtime_cdylib",
    "ori_version",
    "abi_version",
    "profile",
    "native_static_libs",
    "generated_by"
  ],
  "properties": {
    "target": {
      "type": "string",
      "pattern": "[A-Za-z0-9][A-Za-z0-9_.-]*-[A-Za-z0-9_.-]+"
    },
    "runtime": { "type": "string", "pattern": ".+" },
    "runtime_cdylib": { "type": "string", "pattern": ".+" },
    "runtime_sha256": {
      "type": "string",
      "pattern": "[0-9a-fA-F]{64}"
    },
    "runtime_cdylib_sha256": {
      "type": "string",
      "pattern": "[0-9a-fA-F]{64}"
    },
    "ori_version": {
      "type": "string",
      "pattern": "[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?"
    },
    "abi_version": {
      "type": "string",
      "pattern": "ori-native-abi-.+"
    },
    "profile": { "type": "string", "enum": ["debug", "release"] },
    "native_static_libs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": ".+" }
    },
    "generated_by": { "type": "string", "pattern": ".+" }
  }
}
