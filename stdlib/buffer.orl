module ori.buffer

-- Contiguous, fixed-length, indexed numeric buffer for high-performance CPU graphics and FFI (GFX-BUFFER-1).

public alias Buffer[T] = buffer[T]

public from_list[T](items: list[T]) -> buffer[T]
    const n: int = ori.list.len(items)
    var b: buffer[T] = ori.buffer.new(n)
    var i: int = 0
    while i < n
        if some(v) = ori.list.try_get(items, i)
            ori.buffer.set(b, i, v)
        end
        i = i + 1
    end
    return b
end

public get_or[T](buf: buffer[T], index: int, fallback: T) -> T
    if index >= 0 and index < ori.buffer.len(buf)
        return ori.buffer.get(buf, index)
    end
    return fallback
end
