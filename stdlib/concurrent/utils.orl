module ori.concurrent.utils

-- Compatibility module. Keep the implementation in the canonical parent
-- (`ori.concurrent`) and forward the legacy path so the two APIs cannot drift.
import ori.concurrent = base

public copy_int(value: int) -> int
    return base.copy_int(value)
end

public copy_bool(value: bool) -> bool
    return base.copy_bool(value)
end

public copy_float(value: float) -> float
    return base.copy_float(value)
end

public copy_string(value: string) -> string
    return base.copy_string(value)
end

public copy_bytes(value: bytes) -> bytes
    return base.copy_bytes(value)
end

public copy_list_int(value: list[int]) -> list[int]
    return base.copy_list_int(value)
end

public copy_list_string(value: list[string]) -> list[string]
    return base.copy_list_string(value)
end

public copy_map_string_string(value: map[string, string]) -> map[string, string]
    return base.copy_map_string_string(value)
end

public copy_set_string(value: set[string]) -> set[string]
    return base.copy_set_string(value)
end

public transfer_int(value: int) -> int
    return base.transfer_int(value)
end

public transfer_string(value: string) -> string
    return base.transfer_string(value)
end

public transfer_list_string(value: list[string]) -> list[string]
    return base.transfer_list_string(value)
end
