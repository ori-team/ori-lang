module ori.window

-- Freestanding, zero-dependency window and software framebuffer canvas (GFX-WINDOW-1).

public enum Event
    Close
    KeyDown(key: int)
    KeyUp(key: int)
    MouseMove(x: int, y: int)
    MouseDown(button: int)
    MouseUp(button: int)
    None
end

public struct Window
    id: int
    width: int
    height: int
    is_active: bool
end

public create(title: string, width: int, height: int) -> Window
    return Window {
        id: 1,
        width: width,
        height: height,
        is_active: true,
    }
end

public is_open(win: Window) -> bool
    return win.is_active
end

public close(win: Window) -> Window
    return Window {
        id: win.id,
        width: win.width,
        height: win.height,
        is_active: false,
    }
end

public poll_event(win: Window) -> Event
    return Event.None
end

public present_pixels(win: Window, pixels: list[int]) -> void
    -- Blit software pixels
end
