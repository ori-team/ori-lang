module ori.process.utils

-- Compatibility module. Keep the implementation in the canonical parent
-- (`ori.process`) and forward the legacy path so the two APIs cannot drift.
import ori.process = base

public exit_code(capture: map[string, string]) -> int
    return base.exit_code(capture)
end

public stdout(capture: map[string, string]) -> string
    return base.stdout(capture)
end

public stderr(capture: map[string, string]) -> string
    return base.stderr(capture)
end
